{
  "name": "use-ssr-storage",
  "version": "0.1.0",
  "description": "SSR-safe localStorage/sessionStorage React hook built on useSyncExternalStore — no hydration mismatches, cross-tab sync, and typed error handling.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom tests/useSSRStorage.test.tsx",
    "test:ssr": "vitest run tests/ssr.test.tsx",
    "test:all": "vitest run",
    "size": "size-limit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:all && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "size-limit": "^11.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "react",
    "hooks",
    "ssr",
    "localstorage",
    "sessionstorage",
    "useSyncExternalStore",
    "nextjs",
    "remix",
    "hydration"
  ],
  "license": "MIT",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "2 KB"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiddheshTawde/use-ssr-storage.git"
  },
  "bugs": {
    "url": "https://github.com/SiddheshTawde/use-ssr-storage/issues"
  },
  "homepage": "https://github.com/SiddheshTawde/use-ssr-storage#readme"
}
